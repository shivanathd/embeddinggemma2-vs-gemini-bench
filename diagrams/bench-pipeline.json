   "dot": "emerald",
   "title": "Fair comparison",
   "items": [
    "Both models see identical inputs, truncated at 16k characters",
    "Each model gets its own recommended task prompt",
    "Vectors are L2-normalised and compared by cosine"
   ]
  },
  {
   "dot": "cyan",
   "title": "Statistics",
   "items": [
    "Per-query scores for both models on the same queries",
    "2,000 paired bootstrap resamples give a 95% interval",
    "A difference counts only if the interval excludes zero"
   ]
  },
  {
   "dot": "amber",
   "title": "Reproducible",
   "items": [
    "Every embedding is cached, so a re-run costs nothing",
